{
  "info": {
    "_postman_id": "38a6a171-2ca2-4d1f-abda-75b47981c535",
    "name": "CrisisAid Coursework API",
    "description": "Local educational workflow. Authenticate separately as citizen/coordinator/logistics based on endpoint, set IDs from live responses, never use this test data in a real emergency.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "Login (capture JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set(\"jwt\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 Crises and Requests",
      "item": [
        {
          "name": "List crises (copy ID to environment)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/crises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "crises"
              ]
            }
          }
        },
        {
          "name": "Submit assistance request (citizen JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"crisisId\": \"{{crisisId}}\",\n  \"category\": \"Water\",\n  \"description\": \"Need drinking water at community centre (DEMO)\",\n  \"urgency\": \"High\",\n  \"peopleAffected\": 4,\n  \"requestedQuantity\": 4,\n  \"latitude\": 6.9271,\n  \"longitude\": 79.8612,\n  \"medicalEmergency\": false,\n  \"accessibilityNeeded\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.environment.set(\"requestId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests"
              ]
            }
          }
        },
        {
          "name": "Case history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{requestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{requestId}}"
              ]
            }
          }
        },
        {
          "name": "Assess AI recommendation (coordinator JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{requestId}}/assess",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{requestId}}",
                "assess"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Approve recommendation (coordinator JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{requestId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{requestId}}",
                "review"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"Approved\",\n  \"finalPriority\": null,\n  \"reason\": \"Reviewed evidence and prioritisation.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Human override example (requires pending recommendation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{requestId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{requestId}}",
                "review"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"Modified\",\n  \"finalPriority\": 91,\n  \"reason\": \"Confirmed immediate accessibility need.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
