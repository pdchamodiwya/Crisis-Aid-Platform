    {
      "name": "05 Member 03 - Resource, Logistics and Partner Coordination",
      "item": [
        {
          "name": "Logistics Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/logistics/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "logistics", "dashboard"] }
          }
        },
        {
          "name": "Create Resource with Batch & Condition",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Emergency Tarpaulins\",\n  \"category\": \"Shelter materials\",\n  \"unit\": \"sheets\",\n  \"availableQuantity\": 50,\n  \"area\": \"Colombo Depot\",\n  \"latitude\": 6.9271,\n  \"longitude\": 79.8612,\n  \"accessible\": true,\n  \"condition\": \"Good\",\n  \"batchNumber\": \"BATCH-TARP-01\",\n  \"description\": \"Reinforced waterproof shelter sheets\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/resources/create", "host": ["{{baseUrl}}"], "path": ["api", "resources", "create"] }
          }
        },
        {
          "name": "Replenish Stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 25,\n  \"notes\": \"UNHCR airlift donation intake\",\n  \"batchNumber\": \"BATCH-AIRLIFT-22\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/resources/{{resourceId}}/replenish", "host": ["{{baseUrl}}"], "path": ["api", "resources", "{{resourceId}}", "replenish"] }
          }
        },
        {
          "name": "Adjust Stock & Record Movement",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newQuantity\": 65,\n  \"movementType\": \"Stock Damaged\",\n  \"reason\": \"Water damage to outer packaging during storm\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/resources/{{resourceId}}/adjust", "host": ["{{baseUrl}}"], "path": ["api", "resources", "{{resourceId}}", "adjust"] }
          }
