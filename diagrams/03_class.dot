digraph Classes {
 graph [label="Core Domain Class Diagram",fontname="DejaVu Sans",fontsize=21,labelloc=t,ranksep=.65,nodesep=.4,pad=.3];
 node [shape=record,style="rounded,filled",fillcolor="#eff5f9",color="#89aabd",fontname="DejaVu Sans",fontsize=10,margin=".16,.12"];
 edge [arrowhead=empty,color="#5a8198",fontsize=10];
 user [label="{UserAccount|Id: Guid\lEmail: string\lRole: string\lOrganisationId: Guid?\l}"];
 crisis [label="{CrisisEvent|Id: Guid\lType: string\lStatus: string\l}"];
 request [label="{AssistanceRequest|Id: Guid\lCitizenId: Guid\lCrisisId: Guid\lCategory: string\lUrgency: string\lStatus: string\l}",fillcolor="#e0f6ef"];
 decision [label="{AiRecommendation|Priority: int\lConfidence: double\lReviewStatus: string\lReviewedBy: Guid?\l}"];
 resource [label="{ResourceItem|Category: string\lAvailableQuantity: int\lAccessible: bool\l}"];
 reservation [label="{ResourceAllocation|Quantity: int\lApprovedBy: Guid\lStatus: string\l}"];
 shelter [label="{Shelter|Capacity / Occupancy: int\lAccessible: bool\lContact / OpeningHours\lMedical / Sanitation / Food\l}"];
 place [label="{ShelterAllocation|PeopleCount: int\lStatus: Reserved / CheckedIn / CheckedOut / Cancelled\lApprovedBy: Guid\l}"];
 stay [label="{ShelterStay|HouseholdId: Guid\lCheckInAt / CheckOutAt\lOccupancyCount: int\lStatus: string\l}"];
 centre [label="{AssistanceCentre|Type / Area / Facilities\lAccessible: bool\lContact / OpeningHours\lLatitude / Longitude\l}"];
 supply [label="{ShelterSupplyRequest|Category / Quantity\lStatus: string\lAssistanceRequestId: Guid?\l}"];
 volunteer [label="{VolunteerProfile|Area: string\lAvailable / Verified: bool\lLatitude / Longitude?\l}"];
 skill [label="{VolunteerSkill|Name: string\lVerified: bool\lVerifiedBy: Guid?\l}"];
 availability [label="{VolunteerAvailability|StartsAt: DateTime\lEndsAt: DateTime\l}"];
 qualification [label="{VolunteerQualification|Name / Issuer\lVerified: bool\lExpiresAt: DateTime?\l}"];
 task [label="{VolunteerTask|Status: Assigned / Accepted / In Progress / Completed / Declined / Cancelled / Reassigned\lSchedule / Duration / Completion\lCheck-in interval / deadline\l}"];
 activity [label="{VolunteerActivityLog|TaskId: Guid?\lActivity / Notes\lHoursWorked: decimal?\lAt: DateTime\l}"];
 checkin [label="{VolunteerCheckIn|TaskId / VolunteerId\lAt: DateTime\lOptional submitted area / location\lStatus / resolution\l}"];
 audit [label="{AuditEvent|EntityType: string\lEventType: string\lActorId: Guid?\lAt: DateTime\l}"];
 user->request [label="submits 1..*"];crisis->request [label="contains 1..*"];
 request->decision [label="assessments 0..*"];request->reservation [label="allocations 0..*"];
 resource->reservation [label="stock reserved"]; request->place [label="placement 0..1"];
 shelter->place [label="holds reservations"];place->stay [label="checked-in stay 0..1"];
 shelter->supply [label="requests supplies"];supply->request [label="linked logistics case"];
 user->volunteer [label="profile 0..1"];user->centre [label="administrator"];
 volunteer->skill [label="skills 0..*"];volunteer->availability [label="windows 0..*"];
 volunteer->qualification [label="qualifications 0..*"];
 volunteer->task [label="assigned 0..*"];request->task [label="linked cases 0..*"];
 volunteer->activity [label="service history"];task->activity [label="task history"];
 volunteer->checkin [label="voluntary check-ins"];task->checkin [label="safety status"];
 user->audit [label="actor"];
}
